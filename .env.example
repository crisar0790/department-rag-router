# OpenAI credentials
OPENAI_API_KEY=your-key-here

# Langfuse credentials
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com

# Model names will be selected during the compatibility check.
OPENAI_CHAT_MODEL=gpt-5.5-2026-04-23
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EVALUATOR_MODEL=gpt-5.5-2026-04-23

# Persistent vector database directory
CHROMA_PERSIST_DIRECTORY=storage/chroma

# Initial chat settings; validate them during evaluation.
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=0
MAX_OUTPUT_TOKENS=2048